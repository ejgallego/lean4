theorem ex2 : ∀ (x : Nat), (if x = 0 ∧ True then x + 1 else 2 + x) = if x = 0 then 1 else x + 2 :=
fun x =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (Bool.cond_cond_congr instDecidableAnd.1 (instDecidableEqNat x 0).1
              (Decidable.decide_congr (and_true (x = 0)) instDecidableAnd (instDecidableEqNat x 0)) (x + 1) (2 + x))
            (Bool.cond_congr (Eq.refl (instDecidableEqNat x 0).1)
              (fun a =>
                let h := Eq.mp (propext { mp := of_decide_eq_true, mpr := decide_eq_true }) a;
                Eq.trans (congrFun' (congrArg HAdd.hAdd h) 1) (Nat.zero_add 1))
              fun a => Nat.add_comm 2 x)))
        (if x = 0 then 1 else x + 2))
      (eq_self (if x = 0 then 1 else x + 2)))
theorem ex3 : ∀ (x : Nat), (if h : x = 0 ∧ True then x + 1 else 2 + x) = if h : x = 0 then 1 + x else x + 2 :=
fun x =>
  of_eq_true
    (Eq.trans
      (congr
        (congrArg Eq
          (Eq.trans (dite_congr (and_true (x = 0)) (fun h => Eq.refl (x + 1)) fun h => Nat.add_comm 2 x)
            (dite_eq_cond (x = 0) Nat (x + 1) (x + 2))))
        (Eq.trans (dite_congr (Eq.refl (x = 0)) (fun h => Nat.add_comm 1 x) fun h => Eq.refl (x + 2))
          (dite_eq_cond (x = 0) Nat (x + 1) (x + 2))))
      (eq_self (if x = 0 then x + 1 else x + 2)))
