partial def f.loop._unsafe_rec : (i : Nat) → Bool :=
fun (i : Nat) =>
  let v : Bool := Bool.true;
  @cond.{1} Bool (instDecidableEqBool v v).1
    (f.loop._unsafe_rec
      (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) i
        (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
    v
