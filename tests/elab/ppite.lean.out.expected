def f : List Nat → IO Unit :=
fun xs =>
  xs.forM fun x =>
    bif x == 0 then do
      IO.println "foo"
      IO.println "zero"
    else
      bif x % 2 == 0 then do
        IO.println x
        IO.println "even"
      else do
        IO.println x
        IO.println "odd"
bif true then 1 else 0 : Nat
if h : true = true then 1 else 0 : Nat
